{
  "name": "vibe-ai",
  "version": "1.0.0",
  "description": "ZUNO PLAYCORE: personal AI companion, planner and trusted-owner Study Studio",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/companion.test.cjs tests/study.test.cjs tests/exam-rescue.test.cjs tests/radio.test.cjs tests/radio-metadata.test.cjs tests/release-security.test.cjs tests/release-mobile.test.cjs",
    "study:setup": "node scripts/setup-study.cjs",
    "study:model": "node scripts/configure-study-model.cjs",
    "test:study:live": "node tests/study-live.cjs",
    "test:radio:live": "node --test tests/radio-live-smoke.cjs",
    "check": "node scripts/check.cjs",
    "lint": "eslint .",
    "build": "npm run check && node scripts/build.cjs",
