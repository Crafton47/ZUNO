    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sql.js": "^1.12.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "qs": "^6.16.1"
