PORT=3000
# Required: generate a unique random value, at least 32 bytes. Placeholder is rejected.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Optional SQLite path; one Node process per file. Keep outside public/.
# DB_PATH=/absolute/private/path/zuno.db
GEMINI_API_KEY=
# Optional: enable YouTube Data API v3 for playlist titles, artwork and the track browser. Server only.
YOUTUBE_API_KEY=
NVIDIA_API_KEY=
CHAT_PROVIDER=nvidia
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_CHAT_MODEL=gemini-2.5-flash

STUDY_ENABLED=false
STUDY_OWNER_ID=
OPEN_NOTEBOOK_URL=http://127.0.0.1:5055
OPEN_NOTEBOOK_PASSWORD=
